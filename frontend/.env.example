# Frontend Environment Variables
# Copy this file to .env.local (never commit .env.local to git)

# --------------------------------------------------------------------------
# VITE_API_URL  — REQUIRED for production deployments
# --------------------------------------------------------------------------
# Set this to your backend API origin (no trailing slash).
# Example values:
#   Vercel backend:   https://pharma-backend.vercel.app
#   Render backend:   https://pharma-api.onrender.com
#   Local (default):  leave empty — Vite dev server proxies /api and /uploads
#
# Without this, product images will ONLY work via the Vite dev-server proxy
# (localhost). In a production build they will 404.
# --------------------------------------------------------------------------
VITE_API_URL=
